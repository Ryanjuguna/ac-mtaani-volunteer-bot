# Environment Configuration for American Corner Mtaani Volunteer Task Manager

# App Settings
APP_NAME="American Corner Mtaani Volunteer Task Manager"
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Task Trigger Tag (e.g. @task, #task, !task)
TASK_TRIGGER_TAG="@task"

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# WhatsApp Gateway (green_api or mock)
WHATSAPP_PROVIDER="mock"
GREEN_API_INSTANCE_ID=""
GREEN_API_TOKEN=""
MTAANI_GROUP_CHAT_ID="12036304@g.us"
COORDINATOR_PHONE="+254700000000"

# Google Sheets Dashboard Integration
ENABLE_SHEETS_SYNC=false
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_FILE="credentials.json"

# Local Storage
DATABASE_PATH="./data/tasks.db"
VOLUNTEERS_FILE="./data/volunteers.json"
